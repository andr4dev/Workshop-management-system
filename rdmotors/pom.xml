<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>com.workshopmanagement</groupId>
	<artifactId>rdmotors-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>rdmotors-parent</name>
	<description>RD Motors — punto de venta de repuestos</description>

	<!--
	  Dos modulos, a proposito:

	    domain  las reglas del negocio y los puertos. No arranca solo, es una libreria.
	    pos     la aplicacion que corre en la PC de la tienda. Aqui vive todo lo que
	            toca el mundo real: Postgres, HTTP, la impresora termica.

	  La dependencia va en UN solo sentido:  pos ──► domain
	  Como domain no declara dependencia de pos, el compilador impide importar
	  infraestructura desde el dominio. La regla de arquitectura es una ley del build,
	  no una convencion que se olvida.

	  'cloud' (el espejo de solo lectura para el panel del propietario) se agregara
	  cuando exista codigo que poner adentro. Se enchufa a domain igual que pos, sin
	  reestructurar nada.
	-->
	<modules>
		<module>domain</module>
		<module>pos</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.workshopmanagement</groupId>
				<artifactId>domain</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
